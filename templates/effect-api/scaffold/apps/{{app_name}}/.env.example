# Database connection. Local dev value points at the docker-compose
# Postgres in this repo. Production sets via secrets manager.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{project_name}}_dev

# HTTP server port. Optional, defaults to 3000.
PORT=3000

# One of Trace, Debug, Info, Warn, Error, Fatal. Optional, defaults to Info.
LOG_LEVEL=Info

# One of pretty (dev), json (production). Optional, defaults to pretty.
LOG_FORMAT=pretty
